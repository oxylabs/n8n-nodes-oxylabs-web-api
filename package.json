{
	"name": "n8n-nodes-oxylabs-web-api",
	"version": "0.1.4",
	"description": "n8n node for the Oxylabs Web API: search the web and scrape any page, including JavaScript-heavy and bot-protected ones.",
	"license": "MIT",
	"homepage": "https://github.com/oxylabs/n8n-nodes-oxylabs-web-api",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"oxylabs",
		"web scraping",
		"web search",
		"scraper"
	],
	"author": {
		"name": "Oxylabs",
		"email": "giedrius.stankauskas@oxylabs.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oxylabs/n8n-nodes-oxylabs-web-api.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OxylabsWebApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OxylabsWebApi/OxylabsWebApi.node.js"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"release-it": {
		"git": {
			"tagName": "v${version}"
		}
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
